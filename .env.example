# ── LastEdge Trading Engine Configuration ─────────────────────────────────────
# MT5 Configuration
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEFRAME=H1
MT5_MAGIC_NUMBER=123456
MT5_DEVIATION=20

# Risk Management
MT5_RISK_PCT=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=6.0
MAX_CONSECUTIVE_LOSSES=3
MAX_SIMULTANEOUS_POSITIONS=3
CIRCUIT_BREAKER_ENABLED=1

# Trading Engine REST API
TRADING_API_HOST=0.0.0.0
TRADING_API_PORT=8081
TRADING_API_KEY=

# Execution & Safety
AUTO_EXECUTE_SIGNALS=1
AUTO_EXECUTE_CONFIDENCE=HIGH
ENABLE_PARTIAL_CLOSES=1
TRAILING_STOP_MODE=atr
NEWS_FILTER_ENABLED=1
SPREAD_FILTER_ENABLED=1
MAX_SPREAD_PIPS=3.0
LOG_LEVEL=INFO
